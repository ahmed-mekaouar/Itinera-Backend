generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  tourist
  provider
  admin
}

enum ProviderType {
  restaurant
  hotel
  agency
  transport
}

enum ProviderStatus {
  pending
  approved
  rejected
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum PaymentStatus {
  pending
  paid
  refunded
  failed
}

enum PaymentMethod {
  card
  cash
  bank_transfer
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password_hash String
  full_name     String
  phone         String?
  role          Role      @default(tourist)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  provider           Provider?
  bookings           Booking[]
  reviews            Review[]
  wishlist           Wishlist[]
  sent_messages      Message[]     @relation("SentMessages")
  received_messages  Message[]     @relation("ReceivedMessages")
  refresh_tokens     RefreshToken[]

  @@map("users")
}

model Provider {
  id            Int            @id @default(autoincrement())
  user_id       Int            @unique
  provider_type ProviderType
  business_name String
  description   String         @default("")
  phone         String?
  image         String?
  documents     Json           @default("[]")
  status        ProviderStatus @default(pending)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  services      Service[]
  hotels        Hotel[]
  tours         Tour[]

  @@index([status])
  @@map("providers")
}

model Service {
  id           Int      @id @default(autoincrement())
  provider_id  Int
  name         String
  description  String   @default("")
  price        Decimal  @db.Decimal(10, 2)
  category     String
  location     String?
  address      String?
  images       Json     @default("[]")
  availability Json     @default("[]")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  provider     Provider   @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  bookings     Booking[]
  reviews      Review[]
  wishlist     Wishlist[]

  @@index([category])
  @@index([provider_id, category])
  @@map("services")
}

model Booking {
  id           Int           @id @default(autoincrement())
  tourist_id   Int
  service_id   Int
  booking_date DateTime
  status       BookingStatus @default(pending)
  total_price  Decimal       @db.Decimal(10, 2)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  tourist      User          @relation(fields: [tourist_id], references: [id])
  service      Service       @relation(fields: [service_id], references: [id])
  payment      Payment?
  messages     Message[]

  @@index([status, created_at])
  @@index([tourist_id])
  @@index([service_id])
  @@map("bookings")
}

model Hotel {
  id             Int      @id @default(autoincrement())
  provider_id    Int
  name           String
  description    String   @default("")
  rooms_count    Int
  check_in_time  String
  check_out_time String
  amenities      Json     @default("[]")
  images         Json     @default("[]")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  provider       Provider @relation(fields: [provider_id], references: [id], onDelete: Cascade)

  @@map("hotels")
}

model Tour {
  id               Int         @id @default(autoincrement())
  provider_id      Int
  name             String
  description      String      @default("")
  duration         Int
  price            Decimal     @db.Decimal(10, 2)
  max_participants Int
  images           Json        @default("[]")
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  provider         Provider    @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  itineraries      Itinerary[]

  @@map("tours")
}

model Itinerary {
  id          Int      @id @default(autoincrement())
  tour_id     Int
  day_number  Int
  description String
  location    String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tour        Tour     @relation(fields: [tour_id], references: [id], onDelete: Cascade)

  @@map("itineraries")
}

model Review {
  id         Int      @id @default(autoincrement())
  tourist_id Int
  service_id Int
  rating     Int
  comment    String   @default("")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tourist    User     @relation(fields: [tourist_id], references: [id])
  service    Service  @relation(fields: [service_id], references: [id])

  @@unique([tourist_id, service_id])
  @@map("reviews")
}

model Message {
  id          Int      @id @default(autoincrement())
  sender_id   Int
  receiver_id Int
  booking_id  Int?
  content     String
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now())

  sender      User     @relation("SentMessages", fields: [sender_id], references: [id])
  receiver    User     @relation("ReceivedMessages", fields: [receiver_id], references: [id])
  booking     Booking? @relation(fields: [booking_id], references: [id])

  @@index([receiver_id, is_read])
  @@map("messages")
}

model Wishlist {
  id         Int      @id @default(autoincrement())
  tourist_id Int
  service_id Int
  created_at DateTime @default(now())

  tourist    User     @relation(fields: [tourist_id], references: [id])
  service    Service  @relation(fields: [service_id], references: [id])

  @@unique([tourist_id, service_id])
  @@map("wishlist")
}

model Payment {
  id             Int           @id @default(autoincrement())
  booking_id     Int           @unique
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(pending)
  payment_method PaymentMethod
  transaction_id String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  booking        Booking       @relation(fields: [booking_id], references: [id])

  @@map("payments")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_tokens")
}
